---
import Layout from '../../layouts/Layout.astro';
import PhotoSpace from '../../components/PhotoSpace.astro';
import ContentNote from '../../components/ContentNote.astro';
import Enquiry from '../../components/Enquiry.astro';
import Arrow from '../../components/Arrow.astro';
import GalleryPreview from '../../components/GalleryPreview.astro';
import { projects } from '../../data/content';
import PublicStory from '../../components/PublicStory.astro';
import { loadSiteContent } from '../../lib/site-content';
export function getStaticPaths() { const content = loadSiteContent(); return (content?.stories ?? projects).map(project => ({ params: { slug: project.id } })); }
const publicContent = loadSiteContent();
const publicStory = publicContent?.stories.find(story => story.id === Astro.params.slug);
const project = projects.find(project => project.id === Astro.params.slug)!;
const wedding = Astro.params.slug === 'wedding-story';
const title = project.title;
const prefix = wedding ? 'STORY-A' : 'STORY-B';
const tones = ['leaf', 'rose', 'sand', 'mist', 'ink', 'rose'] as const;
const frames = Array.from({ length: project.frameCount }, (_, i) => ({ index: i, label: `Photograph ${i + 1}`, tone: tones[i % tones.length], slot: project.gallerySlot }));
const other = wedding ? { slug: 'couple-session', title: 'Couple session' } : { slug: 'wedding-story', title: 'Wedding story' };
---
{publicContent && publicStory ? <PublicStory content={publicContent} story={publicStory} /> : <Layout title={title} page="story"><div class="reading-progress" aria-hidden="true"></div>
  <header class="wrap story-header"><div class="breadcrumb"><a href="/#work"><Arrow direction="left" /> Back to the work</a></div><div class="story-title-row"><div><p class="small-label">{wedding ? 'A day with family and friends' : 'Time for the two of you'}</p><h1>{title}</h1><p class="story-intro-copy">{wedding ? 'Add one wedding, from the people arriving to the moments you want to end on.' : 'Add one couple session with a sense of the place and the people in it.'}</p></div><a class="text-link" href="#enquire">Talk about your plans <Arrow direction="down" /></a></div></header>
  <figure class="wrap story-cover"><PhotoSpace label={wedding ? 'Where this story begins' : 'A place that feels like you'} tone={wedding ? 'sand' : 'rose'} shape="landscape" /><figcaption><ContentNote id={`${prefix}-COVER-01`} /><ContentNote id={`${prefix}-DETAILS-01`} /></figcaption></figure>
  <section class="wrap story-note"><h2>A little context<br />before the photographs.</h2><div><p>Add a note about this assignment. Name a moment you remember, a choice you made or something the couple wanted.</p><ContentNote id={`${prefix}-NOTE-01`} /></div></section>
  <section class="wrap gallery-section" aria-labelledby="gallery-heading"><div class="gallery-header"><h2 id="gallery-heading">Inside the story.</h2><p>Layout preview. Add the edit this assignment needs.</p></div><div class="story-grid">{frames.map(frame => <figure class="story-frame" id={`frame-${frame.index + 1}`}><a href={`#frame-${frame.index + 1}`} data-viewer-trigger={frame.index} data-frame-label={frame.label} data-frame-tone={frame.tone} aria-label={`Open ${frame.label.toLowerCase()} preview`}><PhotoSpace label={frame.label} tone={frame.tone} number={String(frame.index + 1).padStart(2, '0')} /><span class="frame-open" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M14 4h6v6M4 14v6h6m10-16-7 7M4 20l7-7" stroke="currentColor" stroke-width="1.3"/></svg></span></a><figcaption><div><p>{frame.label}</p><span class="frame-counter">Add a photograph and its description.</span></div><a href={`/content-checklist/#${frame.slot}`}>Add content</a></figcaption></figure>)}</div><div style="margin-top:30px"><ContentNote id={`${prefix}-GALLERY-01`} /></div></section>
  <GalleryPreview />
  <div class="wrap story-next"><p class="small-label">There’s another story to explore.</p><a href={`/stories/${other.slug}/`}><h2>{other.title}</h2><Arrow /></a></div>
  <Enquiry story={Astro.params.slug} />
  <dialog class="viewer" data-viewer aria-labelledby="viewer-title"><div class="viewer-inner"><div class="viewer-top"><h2 id="viewer-title">{title}: gallery preview</h2><button class="control-button" data-viewer-close type="button" autofocus>Close <span aria-hidden="true">×</span></button></div><div class="viewer-stage" data-viewer-stage><PhotoSpace label="Photograph 1" tone="leaf" shape="landscape" /></div><div class="viewer-bottom"><div class="viewer-caption"><p data-viewer-caption>Photograph 1</p><a href={`/content-checklist/#${prefix}-GALLERY-01`}>Add the original photograph and description</a></div><div class="viewer-controls"><button type="button" class="control-button" data-viewer-prev aria-label="Previous photograph"><Arrow direction="left" /> Previous</button><span class="viewer-position" data-viewer-position role="status" aria-live="polite">1 / {frames.length}</span><button type="button" class="control-button" data-viewer-next aria-label="Next photograph">Next <Arrow /></button></div></div></div></dialog>
</Layout>}
