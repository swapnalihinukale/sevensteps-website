{
  "name": "seven-steps-private-draft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/build.mjs review",
    "build:public": "node scripts/build.mjs public",
    "build:fixture": "node scripts/build.mjs fixture",
    "build:integration": "node scripts/build.mjs integration",
    "preview:fixture": "node scripts/preview-fixture.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "package:review": "node scripts/package-review.mjs --zip",
    "preview:review-package": "node scripts/preview-review-package.mjs",
    "check": "astro check && node scripts/content-check.mjs && node scripts/copy-check.mjs",
    "test:unit": "node --test tests/*.test.ts",
    "test:media": "node --test tests/media.test.mjs",
    "test:review-package": "node --test tests/review-package.test.mjs",
    "test:build": "node scripts/test-build-boundaries.mjs",
    "test:e2e": "playwright test",
    "test:server": "node scripts/test-server.mjs",
    "lab": "node scripts/enquiry-lab.mjs",
    "lab:site": "node scripts/enquiry-lab.mjs --site",
    "test": "npm run test:unit && npm run test:media && npm run test:review-package && npm run test:server && npm run test:e2e",
    "budget": "node scripts/budget.mjs"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@netlify/database": "2.0.1",
    "@netlify/functions": "6.0.2",
    "astro": "7.3.8",
    "resend": "6.33.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "pg": "8.16.3",
    "typescript": "6.0.3"
  }
}
