---
import Layout from '../layouts/Layout.astro';
import { contentSlots, getReadiness } from '../data/content';
import { isReview } from '../lib/review';
if (!isReview) throw new Error('The content checklist is available only in review builds.');
const readiness = getReadiness();
const sections = [...new Set(contentSlots.map(slot => slot.section))];
---
<Layout title="Content checklist" page="checklist"><div class="wrap"><header class="checklist-intro"><p class="small-label">For the photographer</p><h1>Make this<br />your website.</h1><p>Add your photographs, your words and the details couples need. Each note on the draft links to the matching item here.</p><div class="checklist-stats"><p><strong>{readiness.ready} / {readiness.active}</strong>Content groups ready</p><p><strong>{readiness.total - readiness.ready - readiness.notNeeded}</strong>Need content</p><p><strong>{readiness.notNeeded}</strong>Not needed</p></div></header>
  <section class="checklist-instructions" aria-labelledby="supply-heading"><h2 id="supply-heading">How to add your content</h2><ol><li>Put the original photographs in a folder for each story. Keep the filenames.</li><li>Share those folders with the person building your website. Add a document with the content references below and your answers.</li><li>Include permission to publish the work and any names or words from clients. We will check the files and details before marking an item ready.</li></ol><p>This checklist describes what is needed. It does not upload files or save changes.</p></section>
  <div class="checklist-toolbar" data-checklist-controls hidden><div class="field"><label for="slot-search">Find a content item</label><input id="slot-search" type="search" placeholder="Try photos, contact or a reference" autocomplete="off" /></div><label for="slot-section">Section <select id="slot-section"><option value="all">All sections</option>{sections.map(section => <option value={section}>{section}</option>)}</select></label><button class="control-button" data-checklist-reset type="button">Clear filters</button></div><p class="checklist-count" data-checklist-count role="status">Showing all {contentSlots.length} content groups.</p><div class="checklist-list">{contentSlots.map(slot => <article class="slot-item" id={slot.id} data-slot-item data-slot-section={slot.section}><div><span class="slot-status">{slot.status}</span><h2>{slot.title}</h2><code>{slot.id}</code></div><div><p class="slot-item__request"><strong>{slot.request}</strong> {slot.note}</p><ul class="slot-item__request">{slot.checklist.map(item => <li>{item}</li>)}</ul><p class="slot-item__meta">{slot.section} · {slot.requirement === 'required' ? 'Required for publication' : slot.requirement === 'conditional' ? 'Needed if this feature is included' : 'Optional: confirm whether to include'}</p><a class="text-link" style="font-size:14px;margin-top:10px" href={slot.location}>Find this on the draft</a></div></article>)}</div><p class="empty-results" data-checklist-empty hidden>No matching content. Clear the filters or try another word.</p></div></Layout>
