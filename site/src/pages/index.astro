---
import Layout from '../layouts/Layout.astro';
import PhotoSpace from '../components/PhotoSpace.astro';
import ContentNote from '../components/ContentNote.astro';
import Enquiry from '../components/Enquiry.astro';
import Arrow from '../components/Arrow.astro';
---
<Layout title="Photography & films">
  <section class="wrap hero" aria-labelledby="hero-heading">
    <div class="hero-copy"><p class="small-label">Wedding &amp; couple photography</p><h1 id="hero-heading">Close to<br />the people.</h1><p class="hero-description">Look through a full wedding story or a couple session, at your own pace.</p><a class="text-link" href="#work">Spend a little time with the work <Arrow direction="down" /></a><ContentNote id="HOME-INTRO-01" compact /></div>
    <figure class="hero-main"><PhotoSpace label="The opening photograph" tone="leaf" /><figcaption><ContentNote id="HOME-HERO-01" /></figcaption></figure>
    <figure class="hero-companion"><PhotoSpace label="A quieter moment" tone="rose" shape="square" /><figcaption><p>A quieter moment<br />from the same day.</p><ContentNote id="HOME-HERO-COMPANION-01" compact /></figcaption></figure>
  </section>
  <section class="work-section" id="work" aria-labelledby="work-heading"><div class="wrap"><div class="section-intro"><h2 id="work-heading">Stay for the story.</h2><p>Two spaces for complete assignments. Add the photographs and context that belong together.</p></div><div class="work-grid">
    <article class="work-card"><a href="/stories/wedding-story/"><PhotoSpace label="A wedding, from the inside" shape="landscape" tone="sand" /><div class="work-card__info"><div><p class="small-label">A day with family and friends</p><h3>Wedding story</h3></div><Arrow /></div></a><ContentNote id="STORY-A-COVER-01" compact /></article>
    <article class="work-card"><a href="/stories/couple-session/"><PhotoSpace label="Time for the two of you" shape="portrait" tone="rose" /><div class="work-card__info"><div><p class="small-label">A place, a pause, two people</p><h3>Couple session</h3></div><Arrow /></div></a><ContentNote id="STORY-B-COVER-01" compact /></article>
  </div></div></section>
  <section class="wrap approach-section" id="approach" aria-labelledby="approach-heading"><div class="approach-heading"><h2 id="approach-heading">The person<br />behind the camera.</h2><div><p>Add a short introduction in your own words. Tell couples what you notice, how you work and what it feels like to spend a day with you.</p><ContentNote id="ABOUT-BIO-01" compact /></div></div><div class="approach-body"><figure class="about-space"><PhotoSpace label="Meet the photographer" tone="mist" shape="landscape" /><figcaption><ContentNote id="ABOUT-PORTRAIT-01" /><ContentNote id="TEAM-01" compact /></figcaption></figure><div class="process-list"><p class="planning-only">Proposed steps. Confirm how you work.</p><div class="process-item"><span class="process-number">1</span><div><h3>Tell the photographer your plans</h3><p>Your occasion, the people involved and the photographs you care about.</p></div></div><div class="process-item"><span class="process-number">2</span><div><h3>Talk through the details</h3><p>Add how you agree on coverage, dates, travel and the booking process.</p></div></div><div class="process-item"><span class="process-number">3</span><div><h3>Know what happens next</h3><p>Add what the couple receives, the delivery timeline and how you keep in touch.</p></div></div><ContentNote id="PROCESS-01" compact /><ContentNote id="SERVICES-01" compact /></div></div></section>
  <section class="more-section" aria-labelledby="more-heading"><div class="wrap"><h2 id="more-heading">A few things<br />still to add.</h2><div><details><summary>Films</summary><div class="details-content"><p>Film not added yet.</p><ContentNote id="FILM-01" /></div></details><details><summary>Words from a couple</summary><div class="details-content"><p>Add a review you have permission to share.</p><ContentNote id="REVIEW-01" /></div></details><details><summary>Questions &amp; pricing</summary><div class="details-content"><ContentNote id="FAQ-01" /><ContentNote id="PRICING-01" /></div></details><details><summary>Brand &amp; sharing details</summary><div class="details-content"><ContentNote id="BRAND-NAME-01" /><ContentNote id="BRAND-MARK-01" /><ContentNote id="SEO-SHARE-01" /></div></details></div></div></section>
  <Enquiry />
</Layout>
