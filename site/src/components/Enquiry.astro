---
import ContentNote from './ContentNote.astro';
import Arrow from './Arrow.astro';
import { emailContact } from '../lib/email-contact';
import '../styles/enquiry.css';
interface Props {
  story?: string;
  publicContact?: { heading: string; introduction: string; email: string; privacyText: string; replyNote: string };
  fixture?: boolean;
}
const { story = '', publicContact, fixture = false } = Astro.props;
const contactLink = publicContact ? emailContact(publicContact.email) : null;
const localLab = import.meta.env.PUBLIC_SITE_MODE === 'review' && import.meta.env.ENQUIRY_LOCAL_LAB === '1';
---
<section class="wrap enquiry-section" id="enquire" aria-labelledby="enquiry-heading">
  <div class="enquiry-intro"><h2 id="enquiry-heading">{publicContact ? publicContact.heading : <>Let’s start<br />with your plans.</>}</h2><p>{publicContact?.introduction ?? 'Tell the photographer what you’re planning. A date and location are helpful, even if you’re still deciding.'}</p>{!publicContact && <><ContentNote id="CONTACT-01" compact /><ContentNote id="CONTACT-RESPONSE-01" compact /></>}</div>
  <div class="enquiry-form">
    {publicContact ? <div class="public-contact">
      {fixture ? <><p class="contact-address">{contactLink!.address}</p><p>Test contact. No email is sent.</p></> : <a class="action-link contact-address" href={contactLink!.href}>Email {contactLink!.address} <Arrow /></a>}
      <p>{publicContact.replyNote}</p><p class="contact-privacy">{publicContact.privacyText}</p>
    </div> : <>
    <div class="form-notice" id="draft-form-notice">{localLab ? <><p><strong>Local enquiry test.</strong> Use sample details only.</p><p>This form stores a test enquiry in a temporary database on this computer. It sends no email. Stopping the test removes its data.</p></> : <><p><strong>Draft enquiry form.</strong> Add the receiving address before this can send.</p><p>Use sample details to try the fields. This draft does not send or save them.</p></>}</div>
    <form data-enquiry-form={!localLab || undefined} data-enquiry-active-form={localLab || undefined} method={localLab ? 'post' : undefined} action={localLab ? '/api/enquiries' : undefined} novalidate={!localLab} aria-describedby="draft-form-notice">
      {localLab && <div class="enquiry-errors" data-enquiry-errors tabindex="-1" hidden></div>}
      <div class="story-context"><label for="story-context">Story you’re interested in</label><select id="story-context" name={localLab ? 'story' : undefined}><option value="" selected={!story}>No story selected</option><option value="wedding-story" selected={story === 'wedding-story'}>Wedding story</option><option value="couple-session" selected={story === 'couple-session'}>Couple session</option></select></div>
      <div class="form-row"><div class="field"><label for="enquiry-name">Your name</label><input id="enquiry-name" name={localLab ? 'name' : undefined} autocomplete="off" maxlength="100" placeholder="Your name" aria-required="true" required={localLab} /></div><div class="field"><label for="enquiry-email">Email address</label><input id="enquiry-email" name={localLab ? 'email' : undefined} type="email" inputmode="email" autocomplete="off" maxlength="254" placeholder="you@example.com" aria-required="true" required={localLab} /></div></div>
      <div class="form-row"><div class="field"><label for="enquiry-date">When <span class="field-help">(optional)</span></label><input id="enquiry-date" name={localLab ? 'when' : undefined} maxlength="120" placeholder="A date, month or still deciding" autocomplete="off" /></div><div class="field"><label for="enquiry-place">Where <span class="field-help">(optional)</span></label><input id="enquiry-place" name={localLab ? 'where' : undefined} maxlength="200" placeholder="A city or a place in mind" autocomplete="off" /></div></div>
      <div class="field"><label for="enquiry-note">A little about your plans <span class="field-help">(optional)</span></label><textarea id="enquiry-note" name={localLab ? 'message' : undefined} rows="3" maxlength="4000" placeholder="What would you like photographed?" autocomplete="off"></textarea></div>
      {localLab ? <>
        <p class="enquiry-status" data-enquiry-status role="status" aria-live="polite" aria-atomic="true"></p>
        <div class="submit-row"><button type="submit" data-enquiry-submit disabled>Send enquiry</button><button class="enquiry-restart" type="button" data-enquiry-restart hidden>Start a new enquiry</button></div>
        <noscript><p class="form-notice">Enable JavaScript to use this local test. Nothing has been sent.</p></noscript>
      </> : <>
        <div class="submit-row"><button type="button" disabled>Sending is not set up <Arrow /></button><p>Add the contact and privacy details to activate enquiries.</p></div>
        <p class="form-error" data-form-message role="status" hidden>This draft does not send enquiries. Your details have not been submitted.</p>
      </>}
    </form>
    <ContentNote id="ENQUIRY-FIELDS-01" compact /><ContentNote id="PRIVACY-01" compact />
    </>}
  </div>
</section>
