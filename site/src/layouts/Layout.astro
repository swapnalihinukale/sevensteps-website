---
import '../styles/global.css';
import Arrow from '../components/Arrow.astro';
import { isReview } from '../lib/review';
interface Props { title: string; description?: string; page?: string; }
const { title, description = 'Seven Steps photography website draft. Review the story layouts and add the missing content.', page = 'home' } = Astro.props;
---
<!doctype html>
<html lang="en" data-motion="full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fafaf8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Seven Steps</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {isReview && <aside class="draft-bar" aria-label="Website draft"><div><span class="draft-dot" aria-hidden="true"></span><p><strong>Website draft.</strong> Add the missing photos and details using the content checklist.</p><a href="/content-checklist/">View content checklist <Arrow /></a></div></aside>}
    <header class="site-header">
      <a href="/" class="wordmark" aria-label="Seven Steps home"><span>seven steps<span class="wordmark-dot">.</span></span><span class="wordmark-sub">Photography &amp; films</span></a>
      <nav class="desktop-nav" aria-label="Main navigation"><a href="/#work" aria-current={page === 'story' ? 'location' : undefined}>The work</a><a href="/#approach">The approach</a><a class="nav-enquiry" href="/#enquire">Let’s talk <Arrow /></a></nav>
      <button class="menu-button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle hidden>Menu <span class="menu-lines" aria-hidden="true"></span></button>
      <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile navigation" hidden><a href="/#work">The work <Arrow /></a><a href="/#approach">The approach <Arrow /></a><a href="/#enquire">Let’s talk <Arrow /></a><a href="/content-checklist/">Content checklist</a></nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top"><a class="footer-name" href="/">seven steps.</a><p>Photography &amp; films<br /><span>A website in the making.</span></p><a href="#main" class="text-link">Back to top <Arrow direction="up" /></a></div>
      <div class="footer-bottom"><p>Private review. Brand details need confirmation.</p><div class="motion-preference" data-motion-preference hidden><label for="motion-preference">Motion</label><select id="motion-preference"><option value="full">Full motion</option><option value="still">Still</option></select><span data-motion-note class="sr-only" role="status"></span></div><a href="/content-checklist/#BRAND-NAME-01">Confirm brand details</a></div>
    </footer>
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
