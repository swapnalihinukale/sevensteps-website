---
import ContentNote from './ContentNote.astro';
import Arrow from './Arrow.astro';
interface Props { story?: string; }
const { story = '' } = Astro.props;
---
<section class="wrap enquiry-section" id="enquire" aria-labelledby="enquiry-heading">
  <div class="enquiry-intro"><h2 id="enquiry-heading">Let’s start<br />with your plans.</h2><p>Tell the photographer what you’re planning. A date and location are helpful, even if you’re still deciding.</p><ContentNote id="CONTACT-01" compact /><ContentNote id="CONTACT-RESPONSE-01" compact /></div>
  <div class="enquiry-form">
    <div class="form-notice" id="draft-form-notice"><p><strong>Draft enquiry form.</strong> Add the receiving address before this can send.</p><p>Use sample details to try the fields. This draft does not send or save them.</p></div>
    <form data-enquiry-form novalidate aria-describedby="draft-form-notice">
      <div class="story-context"><label for="story-context">Story you’re interested in</label><select id="story-context"><option value="" selected={!story}>No story selected</option><option value="wedding-story" selected={story === 'wedding-story'}>Wedding story</option><option value="couple-session" selected={story === 'couple-session'}>Couple session</option></select></div>
      <div class="form-row"><div class="field"><label for="enquiry-name">Your name</label><input id="enquiry-name" autocomplete="off" maxlength="100" placeholder="Your name" aria-required="true" /></div><div class="field"><label for="enquiry-email">Email address</label><input id="enquiry-email" type="email" inputmode="email" autocomplete="off" maxlength="254" placeholder="you@example.com" aria-required="true" /></div></div>
      <div class="form-row"><div class="field"><label for="enquiry-date">When <span class="field-help">(optional)</span></label><input id="enquiry-date" maxlength="100" placeholder="A date, month or still deciding" autocomplete="off" /></div><div class="field"><label for="enquiry-place">Where <span class="field-help">(optional)</span></label><input id="enquiry-place" maxlength="150" placeholder="A city or a place in mind" autocomplete="off" /></div></div>
      <div class="field"><label for="enquiry-note">A little about your plans <span class="field-help">(optional)</span></label><textarea id="enquiry-note" rows="3" maxlength="2000" placeholder="What would you like photographed?" autocomplete="off"></textarea></div>
      <div class="submit-row"><button type="button" disabled>Sending is not set up <Arrow /></button><p>Add the contact and privacy details to activate enquiries.</p></div>
      <p class="form-error" data-form-message role="status" hidden>This draft does not send enquiries. Your details have not been submitted.</p>
    </form>
    <ContentNote id="ENQUIRY-FIELDS-01" compact /><ContentNote id="PRIVACY-01" compact />
  </div>
</section>
