---
import PhotoSpace from './PhotoSpace.astro';
import type { Photograph } from '../lib/media';
interface Props { photos?: Photograph[]; review?: boolean; }
const { photos = [], review = true } = Astro.props;
const tones = ['leaf', 'rose', 'sand', 'mist', 'ink'] as const;
---
<section class="motion-section" data-enhanced-only hidden aria-labelledby="motion-heading"><div class="wrap"><div class="section-intro"><h2 id="motion-heading">A different pace.</h2><p>{review ? 'Try a moving gallery preview. The photographs above stay in place while you explore.' : 'Play one slow pass through the photographs. You can pause whenever you like.'}</p></div><div class="motion-demo" data-motion-demo data-axis="horizontal"><div class="motion-window" data-motion-window><div class="motion-track" data-motion-track aria-hidden="true">{photos.length ? photos.map(photo => <PhotoSpace photo={photo} label={photo.alt} shape="landscape" sizes="(max-width: 720px) 82vw, 440px" />) : tones.map((tone, i) => <PhotoSpace label={`Photograph ${i + 1}`} tone={tone} shape="landscape" />)}</div></div><div class="motion-controls"><button type="button" class="control-button" data-motion-play aria-pressed="false">Play</button><button type="button" class="control-button" data-motion-reset>Stop &amp; reset</button><label>Layout<select data-motion-axis><option value="horizontal">Across</option><option value="vertical">Down</option></select></label><label>Direction<select data-motion-direction><option value="forward">Forward</option><option value="backward">Backward</option></select></label><label>Speed<select data-motion-speed><option value="normal">Normal</option><option value="slow">Slow</option></select></label></div><p class="motion-status" data-motion-status role="status">Paused. Choose Play for one pass. Hover or focus another control to pause.</p></div></div></section>
